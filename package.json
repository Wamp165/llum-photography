    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "next-cloudinary": "^6.19.3",
    "pg": "^8.23.1",
    "postgres": "^3.4.9",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
