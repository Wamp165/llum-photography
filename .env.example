# Copy to .env.local and fill in the values. Validated at startup by src/lib/env.ts.

# --- Database (required) ------------------------------------------------------
# Local:    postgresql://USER:PASSWORD@localhost:5432/llum_photography
# Supabase: Project Settings > Database > Connection string
DATABASE_URL=

# disable | require | prefer | verify-full
# Default: disable for localhost, require for any other host.
DATABASE_SSL=

# Set to false for Supabase's transaction-mode pooler (port 6543). Default: true.
DATABASE_PREPARE=

# --- Better Auth (required) ---------------------------------------------------
# Random secret, at least 32 characters: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the site: http://localhost:3000 in development, https://... in production.
BETTER_AUTH_URL=http://localhost:3000
# Optional extra origins allowed to sign in, comma-separated (e.g. http://192.168.0.29:3000).
BETTER_AUTH_TRUSTED_ORIGINS=

# --- Cloudinary uploads (optional) ---------------------------------------------
# Cloudinary console > Settings > API Keys. Without all three, uploads are disabled
# and images can still be added by pasting their URL.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_API_KEY=
# Secret: only used on the server to sign uploads. Never prefix it with NEXT_PUBLIC_.
CLOUDINARY_API_SECRET=
